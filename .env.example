# App
APP_NAME=food-inference
ENV=local
LOG_LEVEL=INFO
HOST=0.0.0.0
PORT=8000
WORKERS=1
REQUEST_TIMEOUT_S=30
REQUEST_ID_HEADER=X-Request-Id
MAX_UPLOAD_BYTES=5242880
ALLOWED_CONTENT_TYPES=image/jpeg,image/png

# Model
MODEL_PATH=/models/multitask_model.pt
MODEL_FORMAT=pt  # pt|onnx
MODEL_VERSION=v1
DEVICE=cpu  # cpu|cuda
CLASS_LABELS=classA,classB,classC
CLASSES_PATH=/models/classes.json
WARMUP=true

# Database
ENABLE_DB=true
DATABASE_URL=postgresql+psycopg2://postgres:postgres@postgres:5432/inference

# Async
ENABLE_ASYNC=false
REDIS_URL=redis://redis:6379/0

# Object storage (S3/MinIO)
ENABLE_S3=false
S3_ENDPOINT_URL=http://minio:9000
S3_ACCESS_KEY=minio
S3_SECRET_KEY=minio123
S3_BUCKET=uploads
S3_REGION=us-east-1

# Metrics
METRICS_ENABLED=true
